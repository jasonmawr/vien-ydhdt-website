<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Lịch hẹn mới — Admin</title>
  <style>
    body { font-family: Arial, sans-serif; background: #f5f5f5; padding: 20px; }
    .card { background: #fff; border-radius: 12px; max-width: 560px; margin: 0 auto; overflow: hidden; box-shadow: 0 2px 12px rgba(0,0,0,0.1); }
    .header { background: #1e3a5f; padding: 24px 28px; }
    .header h2 { color: #fff; font-size: 17px; margin: 0; }
    .header p { color: rgba(255,255,255,0.7); font-size: 12px; margin: 4px 0 0; }
    .body { padding: 24px 28px; }
    .badge { display: inline-block; background: #fef3c7; color: #d97706; border: 1px solid #fcd34d; border-radius: 20px; padding: 4px 12px; font-size: 12px; font-weight: 700; margin-bottom: 16px; }
    table { width: 100%; border-collapse: collapse; }
    td { padding: 10px 4px; font-size: 13px; border-bottom: 1px solid #f0f0f0; vertical-align: top; }
    .label { color: #888; width: 140px; }
    .value { color: #1a1a1a; font-weight: 600; }
    .btn { display: inline-block; background: #109173; color: #fff; padding: 10px 22px; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: 700; margin-top: 20px; }
    .footer { background: #f9f9f9; padding: 16px 28px; font-size: 11px; color: #aaa; border-top: 1px solid #eee; }
  </style>
</head>
<body>
  <div class="card">
    <div class="header">
      <h2>🔔 Lịch hẹn mới vừa được đặt</h2>
      <p>{{createdAt}}</p>
    </div>
    <div class="body">
      <span class="badge">⏳ Chờ xác nhận</span>
      <table>
        <tr><td class="label">Bệnh nhân</td><td class="value">{{patientName}}</td></tr>
        <tr><td class="label">Điện thoại</td><td class="value">{{patientPhone}}</td></tr>
        <tr><td class="label">Bác sĩ</td><td class="value">{{doctorName}}</td></tr>
        <tr><td class="label">Chuyên khoa</td><td class="value">{{departmentName}}</td></tr>
        <tr><td class="label">Ngày hẹn</td><td class="value">{{appointmentDate}}</td></tr>
        <tr><td class="label">Giờ hẹn</td><td class="value">{{appointmentTime}}</td></tr>
        <tr><td class="label">Triệu chứng</td><td class="value">{{symptoms}}</td></tr>
        <tr><td class="label">Mã lịch hẹn</td><td class="value">{{appointmentId}}</td></tr>
      </table>
      <a href="https://vienydhdt.gov.vn/admin/appointments" class="btn">Xem trong Admin Panel →</a>
    </div>
    <div class="footer">Email tự động từ hệ thống website Viện Y Dược Học Dân Tộc TP.HCM</div>
  </div>
</body>
</html>
